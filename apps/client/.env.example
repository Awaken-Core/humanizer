# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/humanizer

# Better Auth & Security
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Required for production AI endpoints (missing credentials return HTTP 503)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ZRCZZHY7JS
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# DeepSeek AI Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com


# Dodo Payments: use a one-time product and configure payment.succeeded
# at /api/v1/webhooks/dodopayments. Credits require replica-set MongoDB.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_PACK_CREDITS=

# One credit = 1,000,000 microcredits. Confirm rates before enabling paid AI runs.
BOARD_INPUT_MICROCREDITS_PER_1K_TOKENS=
BOARD_OUTPUT_MICROCREDITS_PER_1K_TOKENS=
# Reservation allowance for models without an explicit per-call output limit.
BOARD_DEFAULT_MAX_OUTPUT_TOKENS=384000
